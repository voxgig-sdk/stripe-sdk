# Entity: price

main: kit: entity: price: {

  alias: field: {}

  fields: {
    active: {
      h: "Active"
      n: "active"
      r: true
      sh: "Whether the price can be used for new purchases."
      t: "`$BOOLEAN`"
    }
    billing_scheme: {
      h: "Billing Scheme"
      n: "billing_scheme"
      r: true
      sh: "Describes how to compute the price per period."
      t: "`$STRING`"
    }
    created: {
      fo: "unix-time"
      h: "Created"
      n: "created"
      r: true
      sh: "Time at which the object was created."
      t: "`$INTEGER`"
    }
    currency: {
      fo: "currency"
      h: "Currency"
      n: "currency"
      r: true
      sh: "Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase."
      t: "`$STRING`"
    }
    currency_options: {
      h: "Currency Options"
      n: "currency_options"
      r: false
      sh: "Prices defined in each available currency option."
      t: "`$OBJECT`"
    }
    custom_unit_amount: {
      h: "Custom Unit Amount"
      n: "custom_unit_amount"
      r: false
      sh: "When set, provides configuration for the amount to be adjusted by the customer during Checkout Sessions and Payment Links."
      t: "`$ANY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Unique identifier for the object."
      t: "`$STRING`"
    }
    livemode: {
      h: "Livemode"
      n: "livemode"
      r: true
      sh: "If the object exists in live mode, the value is `true`."
      t: "`$BOOLEAN`"
    }
    lookup_key: {
      h: "Lookup Key"
      n: "lookup_key"
      r: false
      sh: "A lookup key used to retrieve prices dynamically from a static string."
      t: "`$STRING`"
    }
    metadata: {
      h: "Metadata"
      n: "metadata"
      r: true
      sh: "Set of [key-value pairs](https://docs.stripe.com/api/metadata) that you can attach to an object."
      t: "`$OBJECT`"
    }
    nickname: {
      h: "Nickname"
      n: "nickname"
      r: false
      sh: "A brief description of the price, hidden from customers."
      t: "`$STRING`"
    }
    object: {
      h: "Object"
      n: "object"
      r: true
      sh: "String representing the object's type."
      t: "`$STRING`"
    }
    product: {
      h: "Product"
      n: "product"
      r: true
      sh: "The ID of the product this price is associated with."
      t: "`$ANY`"
      union: {
        branches: 3
        count: 6
        depth: 5
      }
    }
    recurring: {
      h: "Recurring"
      n: "recurring"
      r: false
      sh: "The recurring components of a price such as `interval` and `usage_type`."
      t: "`$ANY`"
    }
    tax_behavior: {
      h: "Tax Behavior"
      n: "tax_behavior"
      r: false
      sh: "Only required if a [default tax behavior](https://docs.stripe.com/tax/products-prices-tax-categories-tax-behavior#setting-a-default-tax-behavior-(recommended)) was not provided in the Stripe Tax settings."
      t: "`$STRING`"
    }
    tiers: {
      h: "Tiers"
      n: "tiers"
      r: false
      sh: "Each element represents a pricing tier."
      t: "`$ARRAY`"
    }
    tiers_mode: {
      h: "Tiers Mode"
      n: "tiers_mode"
      r: false
      sh: "Defines if the tiering price should be `graduated` or `volume` based."
      t: "`$STRING`"
    }
    transform_quantity: {
      h: "Transform Quantity"
      n: "transform_quantity"
      r: false
      sh: "Apply a transformation to the reported usage or set quantity before computing the amount billed."
      t: "`$ANY`"
    }
    type: {
      h: "Type"
      n: "type"
      r: true
      sh: "One of `one_time` or `recurring` depending on whether the price is for a one-time purchase or a recurring (subscription) purchase."
      t: "`$STRING`"
    }
    unit_amount: {
      h: "Unit Amount"
      n: "unit_amount"
      r: false
      sh: "The unit amount in cents (or local equivalent) to be charged, represented as a whole integer if possible."
      t: "`$INTEGER`"
    }
    unit_amount_decimal: {
      fo: "decimal"
      h: "Unit Amount Decimal"
      n: "unit_amount_decimal"
      r: false
      sh: "The unit amount in cents (or local equivalent) to be charged, represented as a decimal string with at most 12 decimal places."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "price"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /v1/prices/{price}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "price"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/v1/prices/{price}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              price: "id"
            }
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "prices"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "POST /v1/prices"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/v1/prices"
          s: [
            {
              lit: "v1"
            }
            {
              lit: "prices"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v1/prices"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "active"
                or: "active"
                r: false
                t: "`$BOOLEAN`"
              }
              {
                k: "query"
                n: "created"
                or: "created"
                r: false
                t: "`$ANY`"
              }
              {
                k: "query"
