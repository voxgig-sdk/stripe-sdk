# BasicTrialOfferFlow

main: kit: flow: BasicTrialOfferFlow:
{
  entity: "trial_offer",
  kind: "basic",
  name: "BasicTrialOfferFlow",
  step: [
    {
      i: {
        ref: "trial_offer_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "trial_offer_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "trial_offer_ref01",
        srcdatavar: "trial_offer_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "trial_offer01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-trial_offer_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicTrialOfferFlow"
}