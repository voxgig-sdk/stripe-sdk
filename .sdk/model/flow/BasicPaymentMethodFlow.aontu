# BasicPaymentMethodFlow

main: kit: flow: BasicPaymentMethodFlow:
{
  entity: "payment_method",
  kind: "basic",
  name: "BasicPaymentMethodFlow",
  step: [
    {
      i: {
        ref: "payment_method_ref01"
      }

      m: {
        customer_id: "customer01"
      }

      o: "create"
    }

    {
      m: {
        customer_id: "customer01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "payment_method_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "payment_method_ref01",
        srcdatavar: "payment_method_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "payment_method01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-payment_method_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPaymentMethodFlow"
}