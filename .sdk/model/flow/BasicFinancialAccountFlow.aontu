# BasicFinancialAccountFlow

main: kit: flow: BasicFinancialAccountFlow:
{
  entity: "financial_account",
  kind: "basic",
  name: "BasicFinancialAccountFlow",
  step: [
    {
      i: {
        ref: "financial_account_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "financial_account_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "financial_account_ref01",
        srcdatavar: "financial_account_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "financial_account01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-financial_account_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicFinancialAccountFlow"
}