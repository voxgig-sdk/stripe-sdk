      t: "`$INTEGER`"
    }
    default_columns: {
      h: "Default Columns"
      n: "default_columns"
      r: false
      sh: "List of column names that are included by default when this Report Type gets run."
      t: "`$ARRAY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The [ID of the Report Type](https://docs.stripe.com/reporting/statements/api#available-report-types), such as `balance.summary.1`."
      t: "`$STRING`"
    }
    livemode: {
      h: "Livemode"
      n: "livemode"
      r: true
      sh: "If the object exists in live mode, the value is `true`."
