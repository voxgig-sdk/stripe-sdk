# Entity: secret

main: kit: entity: secret: {

  alias: field: {}

  fields: {
    created: {
      fo: "unix-time"
      h: "Created"
      n: "created"
      r: true
      sh: "Time at which the object was created."
      t: "`$INTEGER`"
    }
    deleted: {
      h: "Deleted"
      n: "deleted"
      r: false
      sh: "If true, indicates that this secret has been deleted"
      t: "`$BOOLEAN`"
    }
    expires_at: {
      fo: "unix-time"
      h: "Expires At"
      n: "expires_at"
      r: false
      sh: "The Unix timestamp for the expiry time of the secret, after which the secret deletes."
      t: "`$INTEGER`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Unique identifier for the object."
      t: "`$STRING`"
    }
    livemode: {
      h: "Livemode"
      n: "livemode"
      r: true
      sh: "If the object exists in live mode, the value is `true`."
      t: "`$BOOLEAN`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "A name for the secret that's unique within the scope."
      t: "`$STRING`"
    }
    object: {
      h: "Object"
      n: "object"
      r: true
      sh: "String representing the object's type."
      t: "`$STRING`"
    }
    payload: {
      h: "Payload"
      n: "payload"
      r: false
      sh: "The plaintext secret value to be stored."
      t: "`$STRING`"
    }
    scope: {
      h: "Scope"
      n: "scope"
      r: true
      t: "`$OBJECT`"
    }
    type: {
      h: "Type"
      n: "type"
      r: true
      sh: "The secret scope type."
      t: "`$STRING`"
    }
    user: {
      h: "User"
      n: "user"
      r: false
      sh: "The user ID, if type is set to \"user\""
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "secret"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /v1/apps/secrets"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/v1/apps/secrets"
          s: [
            {
              lit: "v1"
            }
            {
              lit: "apps"
            }
            {
              lit: "secrets"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.scope`"
          }
        }
        {
          co: {
            id: "POST /v1/apps/secrets/delete"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/v1/apps/secrets/delete"
          q: {
            "$action": "delete"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "apps"
            }
            {
              lit: "secrets"
            }
            {
              lit: "delete"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.scope`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v1/apps/secrets"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "ending_before"
                or: "ending_before"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "expand"
                or: "expand"
                r: false
                t: "`$ARRAY`"
              }
              {
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "scope"
                or: "scope"
                r: true
                t: "`$OBJECT`"
              }
              {
                k: "query"
                n: "starting_after"
                or: "starting_after"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/apps/secrets"
          q: {
            exist: [
              "ending_before"
              "expand"
              "limit"
              "scope"
              "starting_after"
            ]
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "apps"
            }
            {
              lit: "secrets"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v1/apps/secrets/find"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "expand"
                or: "expand"
                r: false
                t: "`$ARRAY`"
              }
              {
                k: "query"
                n: "name"
                or: "name"
                r: true
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "scope"
                or: "scope"
                r: true
                t: "`$OBJECT`"
              }
            ]
          }
          m: "GET"
          o: "/v1/apps/secrets/find"
          q: {
            "$action": "find"
            exist: [
              "expand"
              "name"
              "scope"
            ]
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "apps"
            }
            {
              lit: "secrets"
            }
            {
              lit: "find"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.scope`"
          }
        }
      ]
    }
  }



}
