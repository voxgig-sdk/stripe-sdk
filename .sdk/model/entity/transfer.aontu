# Entity: transfer

main: kit: entity: transfer: {

  alias: field: {}

  fields: {
    amount: {
      h: "Amount"
      n: "amount"
      r: true
      sh: "Amount in cents (or local equivalent) to be transferred."
      t: "`$INTEGER`"
    }
    amount_reversed: {
      h: "Amount Reversed"
      n: "amount_reversed"
      r: true
      sh: "Amount in cents (or local equivalent) reversed (can be less than the amount attribute on the transfer if a partial reversal was issued)."
      t: "`$INTEGER`"
    }
    balance_transaction: {
      h: "Balance Transaction"
      n: "balance_transaction"
      r: false
      sh: "Balance transaction that describes the impact of this transfer on your account balance."
