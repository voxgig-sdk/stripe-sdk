# BasicShippingRateFlow

main: kit: flow: BasicShippingRateFlow:
{
  entity: "shipping_rate",
  kind: "basic",
  name: "BasicShippingRateFlow",
  step: [
    {
      i: {
        ref: "shipping_rate_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "shipping_rate_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "shipping_rate_ref01",
        srcdatavar: "shipping_rate_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "shipping_rate01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-shipping_rate_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicShippingRateFlow"
}