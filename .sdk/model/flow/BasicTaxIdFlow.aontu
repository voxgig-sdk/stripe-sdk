# BasicTaxIdFlow

main: kit: flow: BasicTaxIdFlow:
{
  entity: "tax_id",
  kind: "basic",
  name: "BasicTaxIdFlow",
  step: [
    {
      i: {
        ref: "tax_id_ref01"
      }

      m: {
        customer_id: "customer01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "tax_id_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "tax_id_ref01",
        srcdatavar: "tax_id_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "tax_id01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-tax_id_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "tax_id_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "tax_id01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "tax_id_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicTaxIdFlow"
}