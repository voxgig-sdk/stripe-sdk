# BasicInvoiceitemFlow

main: kit: flow: BasicInvoiceitemFlow:
{
  entity: "invoiceitem",
  kind: "basic",
  name: "BasicInvoiceitemFlow",
  step: [
    {
      i: {
        ref: "invoiceitem_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "invoiceitem_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "invoiceitem_ref01",
        srcdatavar: "invoiceitem_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "invoiceitem01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-invoiceitem_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicInvoiceitemFlow"
}