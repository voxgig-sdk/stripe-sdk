# Entity: file

main: kit: entity: file: {

  alias: field: {}

  fields: {
    created: {
      fo: "unix-time"
      h: "Created"
      n: "created"
      r: true
      sh: "Time at which the object was created."
      t: "`$INTEGER`"
    }
    data: {
      h: "Data"
      n: "data"
      r: true
      sh: "Details about each object."
      t: "`$ARRAY`"
      union: {
        branches: 2
        count: 1
        depth: 3
      }
    }
    expires_at: {
      fo: "unix-time"
      h: "Expires At"
      n: "expires_at"
      r: false
      sh: "The file expires and isn't available at this time in epoch seconds."
      t: "`$INTEGER`"
    }
    filename: {
      h: "Filename"
      n: "filename"
      r: false
      sh: "The suitable name for saving the file to a filesystem."
      t: "`$STRING`"
    }
    has_more: {
      h: "Has More"
      n: "has_more"
      r: true
      sh: "True if this list has another page of items after this one that can be fetched."
      t: "`$BOOLEAN`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Unique identifier for the object."
      t: "`$STRING`"
    }
    links: {
      h: "Links"
      n: "links"
      r: true
      sh: "A list of [file links](https://docs.stripe.com/api#file_links) that point at this file."
      t: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 5
      }
    }
    object: {
      h: "Object"
      n: "object"
      r: true
      sh: "String representing the object's type."
      t: "`$STRING`"
    }
    purpose: {
      h: "Purpose"
      n: "purpose"
      r: true
      sh: "The [purpose](https://docs.stripe.com/file-upload#uploading-a-file) of the uploaded file."
      t: "`$STRING`"
    }
    size: {
      h: "Size"
      n: "size"
      r: true
      sh: "The size of the file object in bytes."
      t: "`$INTEGER`"
    }
    title: {
      h: "Title"
      n: "title"
      r: false
      sh: "A suitable title for the document."
      t: "`$STRING`"
    }
    type: {
      h: "Type"
      n: "type"
      r: false
      sh: "The returned file type (for example, `csv`, `pdf`, `jpg`, or `png`)."
      t: "`$STRING`"
    }
    url: {
      h: "Url"
      n: "url"
      op: {
        list: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "The URL where this list can be accessed."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "file"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /v1/files"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/v1/files"
          s: [
            {
              lit: "v1"
            }
            {
              lit: "files"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.links`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v1/files"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "created"
                or: "created"
                r: false
                t: "`$ANY`"
              }
              {
                k: "query"
                n: "ending_before"
                or: "ending_before"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "expand"
                or: "expand"
                r: false
                t: "`$ARRAY`"
              }
              {
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "purpose"
                or: "purpose"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "starting_after"
                or: "starting_after"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/files"
          q: {
            exist: [
              "created"
              "ending_before"
              "expand"
              "limit"
              "purpose"
              "starting_after"
            ]
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "files"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v1/files/{file}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "file"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                k: "query"
                n: "expand"
                or: "expand"
                r: false
                t: "`$ARRAY`"
              }
            ]
          }
          m: "GET"
          o: "/v1/files/{file}"
          q: {
            exist: [
              "expand"
              "id"
            ]
          }
          r: {
            param: {
              file: "id"
            }
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "files"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.links`"
          }
        }
      ]
    }
  }



}
