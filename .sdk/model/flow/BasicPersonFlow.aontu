# BasicPersonFlow

main: kit: flow: BasicPersonFlow:
{
  entity: "person",
  kind: "basic",
  name: "BasicPersonFlow",
  step: [
    {
      i: {
        ref: "person_ref01"
      }

      m: {
        account_id: "account01"
      }

      o: "create"
    }

    {
      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "person_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "person_ref01",
        srcdatavar: "person_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "person01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-person_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPersonFlow"
}