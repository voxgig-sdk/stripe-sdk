# BasicFeedbackOptionFlow

main: kit: flow: BasicFeedbackOptionFlow:
{
  entity: "feedback_option",
  kind: "basic",
  name: "BasicFeedbackOptionFlow",
  step: [
    {
      i: {
        ref: "feedback_option_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "feedback_option_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "feedback_option_ref01",
        srcdatavar: "feedback_option_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "feedback_option01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-feedback_option_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicFeedbackOptionFlow"
}