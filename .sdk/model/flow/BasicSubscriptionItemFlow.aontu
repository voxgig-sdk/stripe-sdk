# BasicSubscriptionItemFlow

main: kit: flow: BasicSubscriptionItemFlow:
{
  entity: "subscription_item",
  kind: "basic",
  name: "BasicSubscriptionItemFlow",
  step: [
    {
      i: {
        ref: "subscription_item_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "subscription_item_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "subscription_item_ref01",
        srcdatavar: "subscription_item_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "subscription_item01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-subscription_item_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSubscriptionItemFlow"
}