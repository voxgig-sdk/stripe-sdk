      sh: "A short name for the tax code."
      t: "`$STRING`"
    }
    object: {
      h: "Object"
      n: "object"
      r: true
      sh: "String representing the object's type."
      t: "`$STRING`"
    }
    requirements: {
      h: "Requirements"
      n: "requirements"
      r: false
      sh: "An object that describes more information about the tax location required for this tax code."
      t: "`$ANY`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "tax_code"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v1/tax_codes"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "ending_before"
                or: "ending_before"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "expand"
                or: "expand"
                r: false
                t: "`$ARRAY`"
              }
              {
                k: "query"
                n: "limit"
