        }
        {
          co: {
            id: "POST /v1/payouts"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/v1/payouts"
          s: [
            {
              lit: "v1"
            }
            {
              lit: "payouts"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
