# Entity: supplier

main: kit: entity: supplier: {

  alias: field: {}

  fields: {
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Unique identifier for the object."
      t: "`$STRING`"
    }
    info_url: {
      h: "Info Url"
      n: "info_url"
      r: true
      sh: "Link to a webpage to learn more about the supplier."
      t: "`$STRING`"
    }
    livemode: {
      h: "Livemode"
      n: "livemode"
      r: true
      sh: "Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode."
      t: "`$BOOLEAN`"
    }
    locations: {
      h: "Locations"
      n: "locations"
      r: true
      sh: "The locations in which this supplier operates."
      t: "`$ARRAY`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "Name of this carbon removal supplier."
      t: "`$STRING`"
    }
    object: {
      h: "Object"
      n: "object"
      r: true
      sh: "String representing the object’s type."
      t: "`$STRING`"
    }
    removal_pathway: {
      h: "Removal Pathway"
      n: "removal_pathway"
      r: true
      sh: "The scientific pathway used for carbon removal."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "supplier"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v1/climate/suppliers"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "ending_before"
                or: "ending_before"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "expand"
                or: "expand"
                r: false
                t: "`$ARRAY`"
              }
              {
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "starting_after"
                or: "starting_after"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/climate/suppliers"
          q: {
            exist: [
              "ending_before"
              "expand"
              "limit"
              "starting_after"
            ]
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "climate"
            }
            {
              lit: "suppliers"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v1/climate/suppliers/{supplier}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "supplier"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                k: "query"
                n: "expand"
                or: "expand"
                r: false
                t: "`$ARRAY`"
              }
            ]
          }
          m: "GET"
          o: "/v1/climate/suppliers/{supplier}"
          q: {
            exist: [
              "expand"
              "id"
            ]
          }
          r: {
            param: {
              supplier: "id"
            }
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "climate"
            }
            {
              lit: "suppliers"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
