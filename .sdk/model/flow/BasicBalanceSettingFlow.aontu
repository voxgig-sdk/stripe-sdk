# BasicBalanceSettingFlow

main: kit: flow: BasicBalanceSettingFlow:
{
  entity: "balance_setting",
  kind: "basic",
  name: "BasicBalanceSettingFlow",
  step: [
    {
      i: {
        ref: "balance_setting_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "balance_setting_ref01",
        srcdatavar: "balance_setting_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-balance_setting_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBalanceSettingFlow"
}