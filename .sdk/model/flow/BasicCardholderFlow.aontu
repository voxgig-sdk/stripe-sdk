# BasicCardholderFlow

main: kit: flow: BasicCardholderFlow:
{
  entity: "cardholder",
  kind: "basic",
  name: "BasicCardholderFlow",
  step: [
    {
      i: {
        ref: "cardholder_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "cardholder_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "cardholder_ref01",
        srcdatavar: "cardholder_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "cardholder01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-cardholder_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCardholderFlow"
}