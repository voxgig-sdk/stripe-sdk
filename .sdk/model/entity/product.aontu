# Entity: product

main: kit: entity: product: {

  alias: field: {}

  fields: {
    active: {
      h: "Active"
      n: "active"
      r: true
      sh: "Whether the product is currently available for purchase."
      t: "`$BOOLEAN`"
    }
    created: {
      fo: "unix-time"
      h: "Created"
      n: "created"
      r: true
      sh: "Time at which the object was created."
      t: "`$INTEGER`"
    }
    current_prices_per_metric_ton: {
      h: "Current Prices Per Metric Ton"
      n: "current_prices_per_metric_ton"
      r: true
      sh: "Current prices for a metric ton of carbon removal in a currency's smallest unit."
      t: "`$OBJECT`"
    }
    default_price: {
      h: "Default Price"
      n: "default_price"
      r: false
      sh: "The ID of the [Price](https://docs.stripe.com/api/prices) object that is the default price for this product."
      t: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    delivery_year: {
      h: "Delivery Year"
      n: "delivery_year"
      r: false
      sh: "The year in which the carbon removal is expected to be delivered."
      t: "`$INTEGER`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "The product's description, meant to be displayable to the customer."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Unique identifier for the object."
      t: "`$STRING`"
    }
    images: {
      h: "Images"
      n: "images"
      r: true
      sh: "A list of up to 8 URLs of images for this product, meant to be displayable to the customer."
      t: "`$ARRAY`"
    }
    livemode: {
      h: "Livemode"
      n: "livemode"
      r: true
      sh: "Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode."
      t: "`$BOOLEAN`"
    }
    marketing_features: {
      h: "Marketing Features"
      n: "marketing_features"
      r: true
      sh: "A list of up to 15 marketing features for this product."
      t: "`$ARRAY`"
    }
    metadata: {
      h: "Metadata"
      n: "metadata"
      r: true
      sh: "Set of [key-value pairs](https://docs.stripe.com/api/metadata) that you can attach to an object."
      t: "`$OBJECT`"
    }
    metric_tons_available: {
      fo: "decimal"
      h: "Metric Tons Available"
      n: "metric_tons_available"
      r: true
      sh: "The quantity of metric tons available for reservation."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The Climate product's name."
      t: "`$STRING`"
    }
    object: {
      h: "Object"
      n: "object"
      r: true
      sh: "String representing the object's type."
      t: "`$STRING`"
    }
    package_dimensions: {
      h: "Package Dimensions"
      n: "package_dimensions"
      r: false
      sh: "The dimensions of this product for shipping purposes."
      t: "`$ANY`"
    }
    shippable: {
      h: "Shippable"
      n: "shippable"
      r: false
      sh: "Whether this product is shipped (i.e., physical goods)."
      t: "`$BOOLEAN`"
    }
    statement_descriptor: {
      h: "Statement Descriptor"
      n: "statement_descriptor"
      r: false
      sh: "Extra information about a product which will appear on your customer's credit card statement."
      t: "`$STRING`"
    }
    suppliers: {
      h: "Suppliers"
      n: "suppliers"
      r: true
      sh: "The carbon removal suppliers that fulfill orders for this Climate product."
      t: "`$ARRAY`"
    }
    tax_code: {
      h: "Tax Code"
      n: "tax_code"
      r: false
      sh: "A [tax code](https://docs.stripe.com/tax/tax-categories) ID."
      t: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    tax_details: {
      h: "Tax Details"
      n: "tax_details"
      r: false
      sh: "Tax details for this product, including the [tax code](/tax/tax-codes) and an optional performance location."
      t: "`$ANY`"
    }
    unit_label: {
      h: "Unit Label"
      n: "unit_label"
      r: false
      sh: "A label that represents units of this product."
      t: "`$STRING`"
    }
    updated: {
      fo: "unix-time"
      h: "Updated"
      n: "updated"
      r: true
      sh: "Time at which the object was last updated."
      t: "`$INTEGER`"
    }
    url: {
      h: "Url"
      n: "url"
      r: false
      sh: "A URL of a publicly-accessible webpage for this product."
      t: "`$STRING`"
    }
  }

