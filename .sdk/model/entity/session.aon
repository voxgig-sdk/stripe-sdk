# Entity: session

main: kit: entity: session: {

  alias: field: {}

  fields: [
    {
      name: "amount_total"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "cancel_url"
      req: false
      type: "`$STRING`"
    }
    {
      name: "created"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "currency"
      req: false
      type: "`$STRING`"
    }
    {
      name: "customer"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "mode"
      req: false
      type: "`$STRING`"
    }
    {
      name: "object"
      req: false
      type: "`$STRING`"
    }
    {
      name: "payment_status"
      req: false
      type: "`$STRING`"
    }
    {
      name: "status"
      req: false
      type: "`$STRING`"
    }
    {
      name: "success_url"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "session"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/checkout/sessions"
          segments: [
            {
              lit: "checkout"
            }
            {
              lit: "sessions"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "customer"
                orig: "customer"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/checkout/sessions"
          segments: [
            {
              lit: "checkout"
            }
            {
              lit: "sessions"
            }
          ]
          select: {
            exist: [
              "customer"
              "limit"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/checkout/sessions/{id}"
          segments: [
            {
              lit: "checkout"
            }
            {
              lit: "sessions"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
