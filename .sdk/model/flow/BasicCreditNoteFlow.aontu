# BasicCreditNoteFlow

main: kit: flow: BasicCreditNoteFlow:
{
  entity: "credit_note",
  kind: "basic",
  name: "BasicCreditNoteFlow",
  step: [
    {
      i: {
        ref: "credit_note_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "credit_note_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "credit_note_ref01",
        srcdatavar: "credit_note_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "credit_note01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-credit_note_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCreditNoteFlow"
}