# BasicBalanceTransactionFlow

main: kit: flow: BasicBalanceTransactionFlow:
{
  entity: "balance_transaction",
  kind: "basic",
  name: "BasicBalanceTransactionFlow",
  step: [
    {
      m: {
        customer_id: "customer01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "balance_transaction_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "balance_transaction_ref01",
        srcdatavar: "balance_transaction_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "balance_transaction01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-balance_transaction_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBalanceTransactionFlow"
}