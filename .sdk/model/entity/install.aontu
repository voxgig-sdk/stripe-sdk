                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "starting_after"
                or: "starting_after"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "status"
                or: "status"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/apps/installs"
          q: {
            exist: [
              "account"
              "app"
              "approval_required"
              "channel"
              "created"
              "created_by"
              "ending_before"
              "expand"
              "limit"
              "starting_after"
              "status"
            ]
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "apps"
            }
            {
              lit: "installs"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v1/apps/installs/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                k: "query"
                n: "expand"
                or: "expand"
                r: false
                t: "`$ARRAY`"
              }
            ]
          }
          m: "GET"
          o: "/v1/apps/installs/{id}"
          q: {
            exist: [
              "expand"
              "id"
            ]
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "apps"
            }
            {
              lit: "installs"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



