# Entity: balance

main: kit: entity: balance: {

  alias: field: {}

  fields: {
    available: {
      h: "Available"
      n: "available"
      r: true
      sh: "Available funds that you can transfer or pay out automatically by Stripe or explicitly through the [Transfers API](https://docs.stripe.com/api#transfers) or [Payouts API](https://docs.stripe.com/api#payouts)."
      t: "`$ARRAY`"
    }
    connect_reserved: {
      h: "Connect Reserved"
      n: "connect_reserved"
      r: false
      sh: "Funds held due to negative balances on connected accounts where [account.controller.requirement_collection](/api/accounts/object#account_object-controller-requirement_collection) is `application`, which includes Custom accounts."
      t: "`$ARRAY`"
    }
    instant_available: {
      h: "Instant Available"
      n: "instant_available"
      r: false
      sh: "Funds that you can pay out using Instant Payouts."
      t: "`$ARRAY`"
    }
    issuing: {
      h: "Issuing"
      n: "issuing"
      r: true
      t: "`$OBJECT`"
    }
    livemode: {
      h: "Livemode"
      n: "livemode"
      r: true
      sh: "If the object exists in live mode, the value is `true`."
      t: "`$BOOLEAN`"
    }
    object: {
      h: "Object"
      n: "object"
      r: true
      sh: "String representing the object's type."
      t: "`$STRING`"
    }
    pending: {
      h: "Pending"
      n: "pending"
      r: true
      sh: "Funds that aren't available in the balance yet."
      t: "`$ARRAY`"
    }
    refund_and_dispute_prefunding: {
      h: "Refund And Dispute Prefunding"
      n: "refund_and_dispute_prefunding"
      r: true
      t: "`$OBJECT`"
    }
  }

  name: "balance"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v1/balance"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "expand"
                or: "expand"
                r: false
                t: "`$ARRAY`"
              }
            ]
          }
          m: "GET"
          o: "/v1/balance"
          q: {
            exist: [
              "expand"
            ]
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "balance"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
