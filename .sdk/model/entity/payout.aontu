              }
            ]
          }
          m: "POST"
          o: "/v1/payouts/{payout}/reverse"
          q: {
            "$action": "reverse"
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              payout: "id"
            }
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "payouts"
            }
