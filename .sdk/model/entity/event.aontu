# Entity: event

main: kit: entity: event: {

  alias: field: {}

  fields: {
    account: {
      h: "Account"
      n: "account"
      r: false
      sh: "The connected account that originates the event."
      t: "`$STRING`"
    }
    api_version: {
      h: "Api Version"
      n: "api_version"
      r: false
      sh: "The Stripe API version used to render `data` when the event was created."
      t: "`$STRING`"
    }
    context: {
      h: "Context"
      n: "context"
      r: false
      sh: "Authentication context needed to fetch the event or related object."
      t: "`$STRING`"
    }
    created: {
      fo: "unix-time"
      h: "Created"
      n: "created"
      r: true
      sh: "Time at which the object was created."
      t: "`$INTEGER`"
    }
    data: {
      h: "Data"
      n: "data"
      r: true
      t: "`$OBJECT`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Unique identifier for the object."
      t: "`$STRING`"
    }
    livemode: {
      h: "Livemode"
      n: "livemode"
      r: true
      sh: "If the object exists in live mode, the value is `true`."
      t: "`$BOOLEAN`"
    }
    object: {
      h: "Object"
      n: "object"
      r: true
      sh: "String representing the object's type."
      t: "`$STRING`"
    }
    pending_webhooks: {
      h: "Pending Webhooks"
      n: "pending_webhooks"
      r: true
      sh: "Number of webhooks that haven't been successfully delivered (for example, to return a 20x response) to the URLs you specify."
      t: "`$INTEGER`"
    }
    request: {
      h: "Request"
      n: "request"
      r: false
      sh: "Information on the API request that triggers the event."
      t: "`$ANY`"
    }
    type: {
      h: "Type"
      n: "type"
      r: true
      sh: "Description of the event (for example, `invoice.created` or `charge.refunded`)."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "event"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v1/events"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "created"
                or: "created"
                r: false
                t: "`$ANY`"
              }
              {
                k: "query"
                n: "delivery_success"
                or: "delivery_success"
                r: false
                t: "`$BOOLEAN`"
              }
              {
                k: "query"
                n: "ending_before"
                or: "ending_before"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "expand"
                or: "expand"
                r: false
                t: "`$ARRAY`"
              }
              {
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "starting_after"
                or: "starting_after"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "type"
                or: "type"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "type"
                or: "type"
                r: false
                t: "`$ARRAY`"
              }
            ]
          }
          m: "GET"
          o: "/v1/events"
          q: {
            exist: [
              "created"
              "delivery_success"
              "ending_before"
              "expand"
              "limit"
              "starting_after"
              "type"
            ]
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "events"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v1/events/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                k: "query"
                n: "expand"
                or: "expand"
                r: false
                t: "`$ARRAY`"
              }
            ]
          }
          m: "GET"
          o: "/v1/events/{id}"
          q: {
            exist: [
              "expand"
              "id"
            ]
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "events"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
