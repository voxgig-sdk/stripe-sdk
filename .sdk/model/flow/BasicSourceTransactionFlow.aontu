# BasicSourceTransactionFlow

main: kit: flow: BasicSourceTransactionFlow:
{
  entity: "source_transaction",
  kind: "basic",
  name: "BasicSourceTransactionFlow",
  step: [
    {
      m: {
        source: "source01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "source_transaction_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "source_transaction_ref01",
        srcdatavar: "source_transaction_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "source_transaction01",
        source_id: "source01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-source_transaction_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSourceTransactionFlow"
}