# BasicConfigurationFlow

main: kit: flow: BasicConfigurationFlow:
{
  entity: "configuration",
  kind: "basic",
  name: "BasicConfigurationFlow",
  step: [
    {
      i: {
        ref: "configuration_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "configuration_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "configuration_ref01",
        srcdatavar: "configuration_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "configuration01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-configuration_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "configuration_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "configuration01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "configuration_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicConfigurationFlow"
}