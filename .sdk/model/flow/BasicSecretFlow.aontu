# BasicSecretFlow

main: kit: flow: BasicSecretFlow:
{
  entity: "secret",
  kind: "basic",
  name: "BasicSecretFlow",
  step: [
    {
      i: {
        ref: "secret_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "secret_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "secret_ref01",
        srcdatavar: "secret_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-secret_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSecretFlow"
}