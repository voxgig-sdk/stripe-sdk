# BasicReportRunFlow

main: kit: flow: BasicReportRunFlow:
{
  entity: "report_run",
  kind: "basic",
  name: "BasicReportRunFlow",
  step: [
    {
      i: {
        ref: "report_run_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "report_run_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "report_run_ref01",
        srcdatavar: "report_run_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "report_run01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-report_run_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicReportRunFlow"
}