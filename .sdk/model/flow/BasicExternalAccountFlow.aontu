# BasicExternalAccountFlow

main: kit: flow: BasicExternalAccountFlow:
{
  entity: "external_account",
  kind: "basic",
  name: "BasicExternalAccountFlow",
  step: [
    {
      i: {
        ref: "external_account_ref01"
      }

      m: {
        account_id: "account01"
      }

      o: "create"
    }

    {
      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "external_account_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "external_account_ref01",
        srcdatavar: "external_account_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "external_account01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-external_account_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicExternalAccountFlow"
}