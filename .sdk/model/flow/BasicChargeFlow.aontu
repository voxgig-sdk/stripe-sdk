# BasicChargeFlow

main: kit: flow: BasicChargeFlow:
{
  entity: "charge",
  kind: "basic",
  name: "BasicChargeFlow",
  step: [
    {
      i: {
        ref: "charge_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "charge_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "charge_ref01",
        srcdatavar: "charge_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "charge01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-charge_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicChargeFlow"
}