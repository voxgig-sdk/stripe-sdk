  step: [
    {
      i: {
        ref: "apple_pay_domain_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "apple_pay_domain_ref01",
        srcdatavar: "apple_pay_domain_ref01_data",
        suffix: "_dt0"
      }

