    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "Human-readable name of the Report Type"
      t: "`$STRING`"
    }
    object: {
      h: "Object"
      n: "object"
      r: true
      sh: "String representing the object's type."
      t: "`$STRING`"
    }
    updated: {
      fo: "unix-time"
      h: "Updated"
      n: "updated"
      r: true
      sh: "When this Report Type was latest updated."
      t: "`$INTEGER`"
    }
    version: {
      h: "Version"
      n: "version"
      r: true
      sh: "Version of the Report Type."
      t: "`$INTEGER`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "report_type"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v1/reporting/report_types"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "expand"
