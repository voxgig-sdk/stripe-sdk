# BasicVerificationSessionFlow

main: kit: flow: BasicVerificationSessionFlow:
{
  entity: "verification_session",
  kind: "basic",
  name: "BasicVerificationSessionFlow",
  step: [
    {
      i: {
        ref: "verification_session_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "verification_session_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "verification_session_ref01",
        srcdatavar: "verification_session_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "verification_session01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-verification_session_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicVerificationSessionFlow"
}