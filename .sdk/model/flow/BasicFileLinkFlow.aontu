# BasicFileLinkFlow

main: kit: flow: BasicFileLinkFlow:
{
  entity: "file_link",
  kind: "basic",
  name: "BasicFileLinkFlow",
  step: [
    {
      i: {
        ref: "file_link_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "file_link_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "file_link_ref01",
        srcdatavar: "file_link_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "file_link01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-file_link_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicFileLinkFlow"
}