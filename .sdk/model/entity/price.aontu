                or: "lookup_key"
                r: false
                t: "`$ARRAY`"
              }
              {
                k: "query"
                n: "product"
                or: "product"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "recurring"
                or: "recurring"
                r: false
                t: "`$OBJECT`"
              }
              {
                k: "query"
                n: "starting_after"
                or: "starting_after"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "type"
                or: "type"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/prices"
          q: {
            exist: [
              "active"
              "created"
              "currency"
              "ending_before"
              "expand"
              "limit"
              "lookup_key"
              "product"
              "recurring"
              "starting_after"
