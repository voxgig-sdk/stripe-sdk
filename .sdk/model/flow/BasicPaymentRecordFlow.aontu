# BasicPaymentRecordFlow

main: kit: flow: BasicPaymentRecordFlow:
{
  entity: "payment_record",
  kind: "basic",
  name: "BasicPaymentRecordFlow",
  step: [
    {
      i: {
        ref: "payment_record_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "payment_record_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "payment_record_ref01",
        srcdatavar: "payment_record_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "payment_record01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-payment_record_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPaymentRecordFlow"
}