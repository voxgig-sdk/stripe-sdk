# BasicReaderFlow

main: kit: flow: BasicReaderFlow:
{
  entity: "reader",
  kind: "basic",
  name: "BasicReaderFlow",
  step: [
    {
      i: {
        ref: "reader_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "reader_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "reader_ref01",
        srcdatavar: "reader_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "reader01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-reader_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "reader_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "reader01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "reader_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicReaderFlow"
}