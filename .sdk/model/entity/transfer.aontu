    }
    reversed: {
      h: "Reversed"
      n: "reversed"
      r: true
      sh: "Whether the transfer has been fully reversed."
      t: "`$BOOLEAN`"
    }
    source_transaction: {
      h: "Source Transaction"
      n: "source_transaction"
      r: false
      sh: "ID of the charge that was used to fund the transfer."
      t: "`$ANY`"
