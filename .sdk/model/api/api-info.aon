# API Information


main: {
  kit: {
    info: {
      description: "Create, list, and retrieve Stripe Checkout Sessions."
      security: {
        in: "header"
        name: "Authorization"
        prefix: "Bearer"
        scheme: "bearerAuth"
        type: "http"
      }
      servers: [
        {
          url: "https://api.stripe.com/v1"
        }
      ]
      summary: "Create, list, and retrieve Stripe Checkout Sessions."
      title: "Stripe Checkout Sessions API"
      version: "1.0.0"
      website: "https://stripe.com"
    }
  }
}

