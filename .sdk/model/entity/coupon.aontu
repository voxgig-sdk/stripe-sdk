# Entity: coupon

main: kit: entity: coupon: {

  alias: field: {}

  fields: {
    amount_off: {
      h: "Amount Off"
      n: "amount_off"
      r: false
      sh: "Amount (in the `currency` specified) that will be taken off the subtotal of any invoices for this customer."
      t: "`$INTEGER`"
    }
    applies_to: {
      h: "Applies To"
      n: "applies_to"
      r: true
      t: "`$OBJECT`"
    }
    created: {
      fo: "unix-time"
      h: "Created"
      n: "created"
      r: true
      sh: "Time at which the object was created."
      t: "`$INTEGER`"
    }
    currency: {
      fo: "currency"
      h: "Currency"
      n: "currency"
      r: false
      sh: "If `amount_off` has been set, the three-letter [ISO code for the currency](https://stripe.com/docs/currencies) of the amount to take off."
      t: "`$STRING`"
    }
    currency_options: {
      h: "Currency Options"
      n: "currency_options"
      r: false
      sh: "Coupons defined in each available currency option."
      t: "`$OBJECT`"
    }
    duration: {
      h: "Duration"
      n: "duration"
      r: true
      sh: "One of `forever`, `once`, or `repeating`."
      t: "`$STRING`"
    }
    duration_in_months: {
      h: "Duration In Months"
      n: "duration_in_months"
      r: false
      sh: "If `duration` is `repeating`, the number of months the coupon applies."
      t: "`$INTEGER`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Unique identifier for the object."
      t: "`$STRING`"
    }
    livemode: {
      h: "Livemode"
      n: "livemode"
      r: true
      sh: "If the object exists in live mode, the value is `true`."
      t: "`$BOOLEAN`"
    }
    max_redemptions: {
      h: "Max Redemptions"
      n: "max_redemptions"
      r: false
      sh: "Maximum number of times this coupon can be redeemed, in total, across all customers, before it is no longer valid."
      t: "`$INTEGER`"
    }
    metadata: {
      h: "Metadata"
      n: "metadata"
      r: false
      sh: "Set of [key-value pairs](https://docs.stripe.com/api/metadata) that you can attach to an object."
      t: "`$OBJECT`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Name of the coupon displayed to customers on for instance invoices or receipts."
      t: "`$STRING`"
    }
    object: {
      h: "Object"
      n: "object"
      r: true
      sh: "String representing the object's type."
      t: "`$STRING`"
    }
    percent_off: {
      h: "Percent Off"
      n: "percent_off"
      r: false
      sh: "Percent that will be taken off the subtotal of any invoices for this customer for the duration of the coupon."
      t: "`$NUMBER`"
    }
    redeem_by: {
      fo: "unix-time"
      h: "Redeem By"
      n: "redeem_by"
      r: false
      sh: "Date after which the coupon can no longer be redeemed."
      t: "`$INTEGER`"
    }
    times_redeemed: {
      h: "Times Redeemed"
      n: "times_redeemed"
      r: true
      sh: "Number of times this coupon has been applied to a customer."
      t: "`$INTEGER`"
    }
    valid: {
      h: "Valid"
      n: "valid"
      r: true
      sh: "Taking account of the above properties, whether this coupon can still be applied to a customer."
      t: "`$BOOLEAN`"
    }
  }

