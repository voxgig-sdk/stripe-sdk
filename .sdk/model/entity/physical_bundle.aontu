# Entity: physical_bundle

main: kit: entity: physical_bundle: {

  alias: field: {}

  fields: {
    card_logo: {
      h: "Card Logo"
      n: "card_logo"
      r: true
      sh: "The policy for how to use card logo images in a card design with this physical bundle."
      t: "`$STRING`"
    }
    carrier_text: {
      h: "Carrier Text"
      n: "carrier_text"
      r: true
      sh: "The policy for how to use carrier letter text in a card design with this physical bundle."
      t: "`$STRING`"
    }
    features: {
      h: "Features"
      n: "features"
      r: true
      t: "`$OBJECT`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Unique identifier for the object."
      t: "`$STRING`"
    }
    livemode: {
      h: "Livemode"
      n: "livemode"
      r: true
      sh: "If the object exists in live mode, the value is `true`."
      t: "`$BOOLEAN`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "Friendly display name."
      t: "`$STRING`"
    }
    object: {
      h: "Object"
      n: "object"
      r: true
      sh: "String representing the object's type."
      t: "`$STRING`"
    }
    second_line: {
      h: "Second Line"
      n: "second_line"
      r: true
      sh: "The policy for how to use a second line on a card with this physical bundle."
      t: "`$STRING`"
    }
    status: {
      h: "Status"
      n: "status"
      r: true
      sh: "Whether this physical bundle can be used to create cards."
      t: "`$STRING`"
    }
    type: {
      h: "Type"
      n: "type"
      r: true
      sh: "Whether this physical bundle is a standard Stripe offering or custom-made for you."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "physical_bundle"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v1/issuing/physical_bundles"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "ending_before"
                or: "ending_before"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "expand"
                or: "expand"
                r: false
                t: "`$ARRAY`"
              }
              {
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "starting_after"
                or: "starting_after"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "status"
                or: "status"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "type"
                or: "type"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/issuing/physical_bundles"
          q: {
            exist: [
              "ending_before"
              "expand"
              "limit"
              "starting_after"
              "status"
              "type"
            ]
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "issuing"
            }
            {
              lit: "physical_bundles"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v1/issuing/physical_bundles/{physical_bundle}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "physical_bundle"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                k: "query"
                n: "expand"
                or: "expand"
                r: false
                t: "`$ARRAY`"
              }
            ]
          }
          m: "GET"
          o: "/v1/issuing/physical_bundles/{physical_bundle}"
          q: {
            exist: [
              "expand"
              "id"
            ]
          }
          r: {
            param: {
              physical_bundle: "id"
            }
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "issuing"
            }
            {
              lit: "physical_bundles"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.features`"
          }
        }
      ]
    }
  }



}
